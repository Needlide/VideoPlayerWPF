<Window x:Class="VideoPlayerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoPlayerWPF.Controls"
        mc:Ignorable="d"
        x:Name="Window"
        Title="Player"
        Height="800" Width="800"
        Background="#FF202020"
        MinHeight="537" MinWidth="642" Icon="/StaticResources/icons8-laptop-play-video-96.png" KeyDown="Window_KeyDown">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="0.4*"/>
            <RowDefinition Height="0.015*"/>
            <RowDefinition Height="0.1*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="grid" Grid.Row="0" Grid.RowSpan="2" MouseWheel="Grid_MouseWheel" MouseLeftButtonDown="grid_MouseLeftButtonDown" MouseRightButtonDown="grid_MouseRightButtonDown" Panel.ZIndex="1">
            <!--<Viewbox x:Name="viewbox" Width="{Binding ActualWidth, ElementName=Window, Mode=OneWay}" Height="{Binding ActualHeight, ElementName=grid, Mode=OneWay}">-->
                <local:Player x:Name="_player" Initialized="_player_Initialized" Width="{Binding ActualWidth, ElementName=grid, Mode=OneWay}" Height="{Binding ActualHeight, ElementName=grid, Mode=OneWay}" Foreground="{x:Null}"/>
            <!--</Viewbox>-->
        </Grid>
        <Viewbox Grid.Row="1" x:Name="PlaceForItemsMenu" HorizontalAlignment="Right"/>
        <Grid x:Name="sliderGrid" Grid.Row="2">
            <Border BorderBrush="Black" BorderThickness="0,0.5,0,0"/>
            <Viewbox x:Name="sliderViewbox">
                <local:VPSlider x:Name="durationSlider" Width="{Binding ActualWidth, ElementName=sliderGrid, Mode=OneWay}" Height="{Binding ActualHeight, ElementName=sliderGrid, Mode=OneWay}" Style="{StaticResource SliderStyle}" Thumb.DragStarted="durationSlider_DragStarted" Thumb.DragCompleted="durationSlider_DragCompleted" LargeChange="0.1" TickFrequency="0.1" Maximum="0"/>
            </Viewbox>
        </Grid>
        <Grid x:Name="bottomPanel" Grid.Row="3" Background="#FF1C1C1C" MouseWheel="Grid_MouseWheel" MouseRightButtonDown="grid_MouseRightButtonDown">
            <Border BorderBrush="Black" BorderThickness="0,0.5,0,0"/>
            <Viewbox>
                <Grid Width="{Binding ActualWidth, ElementName=bottomPanel, Mode=OneWay}" Height="{Binding ActualHeight, ElementName=bottomPanel, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" HorizontalAlignment="Left">
                        <TextBlock x:Name="MediaOpenBlock" TextWrapping="NoWrap" Text="Open media" Foreground="{DynamicResource Button.Static.Foreground}" MouseLeftButtonDown="MediaOpenBlock_MouseLeftButtonDown" Margin="5,10,0,10"/>
                    </Viewbox>
                    <Viewbox Grid.Column="1">
                        <local:VPButton x:Name="PreviousButton" Content="VPButton" Style="{StaticResource ResourceKey=PreviousButtonStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="PreviousButton_Click" ToolTip="Play previous media" IsEnabled="False" Width="21" Margin="72,0,0,10"/>
                    </Viewbox>
                    <Viewbox Grid.Column="2">
                        <local:VPButton x:Name="PlayButton" Content="VPButton" Style="{StaticResource ResourceKey=PlayButtonStyle}" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="PlayButton_Click" ToolTip="Play media" Margin="36,0,0,5"/>
                    </Viewbox>
                    <Viewbox Grid.Column="2">
                        <local:VPButton x:Name="PauseButton" Content="VPButton" Style="{StaticResource ResourceKey=PauseButtonStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Visibility="Collapsed" Click="PauseButton_Click" ToolTip="Pause media" Margin="5,0,0,10" Width="18"/>
                    </Viewbox>
                    <Viewbox Grid.Column="3">
                        <local:VPButton x:Name="NextButton" Content="VPButton" Style="{StaticResource ResourceKey=NextButtonStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="NextButton_Click" ToolTip="Play next media" IsEnabled="False" Width="21" Margin="0,0,60,10"/>
                    </Viewbox>
                    <Viewbox Grid.Column="4">
                        <local:VPButton x:Name="StopButton" Content="VPButton" Style="{StaticResource ResourceKey=StopButtonStyle}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip="Stop media" Click="StopButton_Click"/>
                    </Viewbox>
                    <Viewbox Grid.Column="5" HorizontalAlignment="Right">
                        <local:ThreeDotButton x:Name="DotButton" Style="{StaticResource ThreeDotsStyle}" Click="ThreeDotButton_Click" Margin="0,5,5,5"/>
                    </Viewbox>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
