<Window x:Class="VideoPlayerWPF.OpenMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideoPlayerWPF"
        mc:Ignorable="d"
        Title="OpenMediaWindow" 
        Height="112" Width="378"
        Background="#FF202020" ResizeMode="CanMinimize">
    <Grid>
        <TextBox x:Name="UrlBox" HorizontalAlignment="Left" Margin="82,10,0,0" TextWrapping="NoWrap" Text="" VerticalAlignment="Top" Width="268" ToolTip="Enter media URL" Height="26"/>
        <Label x:Name="label" Content="Media URL" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Foreground="#FF808080"/>
        <Button x:Name="FileDialogButton" Content="Open media from file" HorizontalAlignment="Left" Margin="10,48,0,0" VerticalAlignment="Top" Background="#FF292929" Click="FileDialogButton_Click" Foreground="Gray"/>
        <Button x:Name="OkResultButton" Content="Ok" HorizontalAlignment="Left" Margin="281,48,0,0" VerticalAlignment="Top" Background="#FF292929" Foreground="Gray" BorderBrush="Gray" Width="24" Click="OkResultButton_Click"/>
        <Button x:Name="CancelResultButton" Content="Cancel" HorizontalAlignment="Left" Margin="310,48,0,0" VerticalAlignment="Top" Background="#FF292929" BorderBrush="Gray" Foreground="Gray" Width="41" Click="CancelResultButton_Click"/>

    </Grid>
</Window>
