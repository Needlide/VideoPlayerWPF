<UserControl x:Class="VideoPlayerWPF.Controls.ItemsMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VideoPlayerWPF.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="100">
    <StackPanel Background="#FF1C1C1C">
        <CheckBox x:Name="MuteCheckBox" Content="Mute" Foreground="#FFE4E4E4" Background="#FFE4E4E4" Margin="10, 10, 0, 0"/>
        <CheckBox x:Name="AutoplayCheckBox" Content="Autoplay" Foreground="#FFE4E4E4" Background="#FFE4E4E4" Margin="10, 10, 0, 0"/>
        <Grid Margin="6, 5, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SpeedRatioBox" Grid.Column="0" Width="22" Height="18" Text="1" MaxLines="1" IsUndoEnabled="False"/>
            <Label Grid.Column="1" Content="Speed ratio" Foreground="#FFE4E4E4"/>
        </Grid>
        <Grid Margin="6, 5, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.3*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="BalanceBox" Grid.Column="0" Width="22" Height="18" Text="0.5" MaxLines="1" IsUndoEnabled="False"/>
            <Label Grid.Column="1" Content="Balance" Foreground="#FFE4E4E4"/>
        </Grid>
    </StackPanel>
</UserControl>
